# Copy this file to .env.local and fill in your Supabase project's values (Project settings > API).
# Leave both empty to run the built-in demo (sample data kept in your browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use the "anon" / "publishable" key only. NEVER put the service_role key here: this app runs in the browser.
